// SPEC §7.6 // 数组形参：int a[0..3] 降级为 fence 引用参数
int sum(int a[0..3]) {
    int i = 0;
    int s = 0;
    while (i < 4) { s = s + a[i]; i = i + 1; }
    return s;
}
int fill(int a[0..3], int v) {
    int i = 0;
    while (i < 4) { a[i] = v + i; i = i + 1; }
    return 0;
}
O{
    int v[0..3] = {1, 2, 3, 4};
    print("%d\n", sum(v));
    fill(v, 10);
    print("%d %d %d %d\n", v[0], v[1], v[2], v[3]);
    print("%d\n", sum(v));
}
