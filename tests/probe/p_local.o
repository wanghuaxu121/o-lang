// SPEC §9.2
// 局部变量：普通标量应寄存器化；被取地址的必须落内存
&{int;bump} = o{{int;&x}}{ ${x} = ${x} + {1}  ?{0} }
&{int;f} = o{{int;n}}{
    &{int;i} = {0}
    &{int;s} = {0}
    [${i} < ${n}]{
        ${s} = ${s} + ${i}
        ${i} = ${i} + {1}
    }
    &{int;z} = {5}
    bump{${z}}                 // z 被取地址 → 必须落 _mem
    ?{ ${s} + ${z} }
}
O{ .{int; f{10}} .{str; "\n"} }
