// SPEC §2.11（修正版）：匿名函数作为参数 + 间接调用
// 注意：v0.5 原文的 o{{int;n}}{ ${n} + ${base} } 依赖"末表达式隐式返回"，
// 本实现要求显式 ?{…}（SPEC §7.5）
&{int;apply} = o{{fn;f}, {int;x}}{
    ?{ ${x} | ${f} }
}

O{
    &{int;base} = {int{20}} = {10}
    &{int;r} = {0}
    ${r} = apply{ o{{int;n}}{ ?{${n} + ${base}} }, {5} }
    .{int; ${r}}
    .{str; "\n"}
}
