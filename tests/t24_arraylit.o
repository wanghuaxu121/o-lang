// v0.2 数组字面量初始化 + O{} 里也能导库
O{
    #{"sys"}
    &{int;a} = {int{0;3}} = {10;20;30;40}
    &{int;i} = {0}
    &{int;s} = {0}
    [${i} < ${a}.size{}]{
        .{int; ${a}{${i}}}
        .{str; " "}
        ${s} = ${s} + ${a}{${i}}
        ${i} = ${i} + {1}
    }
    .{str; "| sum="}
    .{int; ${s}}
    .{str; "\n"}

    // 部分初始化：剩下的补 0
    &{int;b} = {int{0;3}} = {1;2}
    ${i} = {0}
    [${i} < {4}]{
        .{int; ${b}{${i}}}
        ${i} = ${i} + {1}
    }
    .{str; "\n"}
}
