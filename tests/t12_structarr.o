// 结构体数组 + 字段访问
&{struct;Pt} = {{int;x}, {int;y}}

O{
    &{Pt;ps} = {Pt{0;2}} = {}          // 3 个 Pt（每个 2 单元）→ 单元 0..5
    &{int;i} = {0}                     // 地址由分配器给，初值 0

    [${i} < {3}]{
        ${ps}{${i}}.x = ${i}
        ${ps}{${i}}.y = ${i} * {10}
        ${i} = ${i} + {1}
    }

    ${i} = {0}
    [${i} < {3}]{
        (${i} > {0}){
            .{str; " "}
        }
        .{int; ${ps}{${i}}.x}
        .{str; ":"}
        .{int; ${ps}{${i}}.y}
        ${i} = ${i} + {1}
    }
    .{str; "\n"}
}
