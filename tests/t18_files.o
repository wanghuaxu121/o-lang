// 文件句柄复用空槽（解释器与 C 后端一致）
#{"file"}

O{
    &{int;i} = {0}
    [${i} < {3}]{
        (${i} > {0}){
            .{str; " "}
        }
        &{int;h} = {0}
        ${h} = open{"_f.txt", "w"}
        .{int; ${h}}
        close{${h}}
        ${i} = ${i} + {1}
    }
    remove{"_f.txt"}
    .{str; "\n"}
}
