// SPEC §12.3
// ============================================================
// 学生管理系统（O 语言示例）
//   入学 / 转学 / 退学 / 月考录入 / 加权分 / 班级平均 / 分班
// 数据：30 个学籍位；status: 0=在读 1=转出 2=退学；track: 0=普通 1=好班
// ============================================================
&{struct;S} = {
    {int;id}, {int;grade}, {int;cls}, {int;status},
    {int;s1}, {int;s2}, {int;s3},
    {double;w}, {int;track}
}

&{S;st} = {S{0;29}} = {}          // 学生表（30 个位）

&{double;w1} = {0.2}
&{double;w2} = {0.3}
&{double;w3} = {0.5}
&{double;thr} = {60.0}            // 好班线

// 入学：找空位写入，返回下标；-1 = 满
&{int;enroll} = o{{S{0;29};&db}, {int;id}, {int;g}, {int;c}}{
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id == {0}){
            ${db}{${i}}.id = ${id}
            ${db}{${i}}.grade = ${g}
            ${db}{${i}}.cls = ${c}
            ${db}{${i}}.status = {0}
            ${db}{${i}}.track = {0}
            ${db}{${i}}.s1 = {0}
            ${db}{${i}}.s2 = {0}
            ${db}{${i}}.s3 = {0}
            ${db}{${i}}.w = {0}
            ?{${i}}
        }
        ${i} = ${i} + {1}
    }
    ?{-1}
}

// 按学号找下标；-1 = 没找到
&{int;find} = o{{S{0;29};&db}, {int;id}}{
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id == ${id}){ ?{${i}} }
        ${i} = ${i} + {1}
    }
    ?{-1}
}

// 录入一次月考：exam=1/2/3
&{int;score} = o{{S{0;29};&db}, {int;id}, {int;exam}, {int;v}}{
    &{int;k} = {0}
    ${k} = find{${db}, ${id}}
    (${k} < {0}){ ?{-1} }
    (${exam} == {1}){ ${db}{${k}}.s1 = ${v} }
    (${exam} == {2}){ ${db}{${k}}.s2 = ${v} }
    (${exam} == {3}){ ${db}{${k}}.s3 = ${v} }
    ?{0}
}

// 汇总：算加权分 w = s1*0.2 + s2*0.3 + s3*0.5
&{int;calcAll} = o{{S{0;29};&db}}{
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id != {0}){
            (${db}{${i}}.status == {0}){
                ${db}{${i}}.w = ${db}{${i}}.s1.as{double} * ${w1} + ${db}{${i}}.s2.as{double} * ${w2} + ${db}{${i}}.s3.as{double} * ${w3}
            }
        }
        ${i} = ${i} + {1}
    }
    ?{0}
}

// 转学（转出）
&{int;transferOut} = o{{S{0;29};&db}, {int;id}}{
    &{int;k} = {0}
    ${k} = find{${db}, ${id}}
    (${k} < {0}){ ?{-1} }
    ${db}{${k}}.status = {1}
    ${db}{${k}}.track = {0}
    ?{0}
}

// 退学
&{int;dropOut} = o{{S{0;29};&db}, {int;id}}{
    &{int;k} = {0}
    ${k} = find{${db}, ${id}}
    (${k} < {0}){ ?{-1} }
    ${db}{${k}}.status = {2}
    ${db}{${k}}.track = {0}
    ?{0}
}

// 班级平均分（只看在读）
&{double;classAvg} = o{{S{0;29};&db}, {int;c}}{
    &{double;sum} = {0}
    &{int;n} = {0}
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id != {0}){
            (${db}{${i}}.status == {0}){
                (${db}{${i}}.cls == ${c}){
                    ${sum} = ${sum} + ${db}{${i}}.w
                    ${n} = ${n} + {1}
                }
            }
        }
        ${i} = ${i} + {1}
    }
    (${n} == {0}){ ?{0.0} }
    ?{${sum} / ${n}.as{double}}
}

// 分班：加权分 >= 好班线 → 好班(1)，否则普通班(0)
&{int;assign} = o{{S{0;29};&db}, {double;t}}{
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id != {0}){
            (${db}{${i}}.status == {0}){
                (${db}{${i}}.w >= ${t}){ ${db}{${i}}.track = {1} }
                (${db}{${i}}.w < ${t}){ ${db}{${i}}.track = {0} }
            }
        }
        ${i} = ${i} + {1}
    }
    ?{0}
}

// 打印名册
&{int;roster} = o{{S{0;29};&db}}{
    .{str; "id  年级 班级 状态  s1  s2  s3   加权   班型\n"}
    &{int;i} = {0}
    [${i} < ${db}.size{}]{
        (${db}{${i}}.id != {0}){
            .{int; ${db}{${i}}.id}
            .{str; "   "}
            .{int; ${db}{${i}}.grade}
            .{str; "    "}
            .{int; ${db}{${i}}.cls}
            .{str; "    "}
            .{int; ${db}{${i}}.status}
            .{str; "    "}
            .{int; ${db}{${i}}.s1}
            .{str; "  "}
            .{int; ${db}{${i}}.s2}
            .{str; "  "}
            .{int; ${db}{${i}}.s3}
            .{str; "  "}
            .{double; ${db}{${i}}.w}
            .{str; "  "}
            .{int; ${db}{${i}}.track}
            .{str; "\n"}
        }
        ${i} = ${i} + {1}
    }
    ?{0}
}

O{
    // ---- 入学：两个年级、三个班 ----
    enroll{${st}, {1001}, {1}, {1}}
    enroll{${st}, {1002}, {1}, {1}}
    enroll{${st}, {1003}, {1}, {2}}
    enroll{${st}, {1004}, {1}, {2}}
    enroll{${st}, {2001}, {2}, {1}}
    enroll{${st}, {2002}, {2}, {1}}
    enroll{${st}, {2003}, {2}, {3}}
    enroll{${st}, {2004}, {2}, {3}}
    enroll{${st}, {3001}, {3}, {1}}
    enroll{${st}, {3002}, {3}, {1}}

    // ---- 三次月考 ----
    score{${st}, {1001}, {1}, {85}}  score{${st}, {1001}, {2}, {90}}  score{${st}, {1001}, {3}, {88}}
    score{${st}, {1002}, {1}, {72}}  score{${st}, {1002}, {2}, {75}}  score{${st}, {1002}, {3}, {70}}
    score{${st}, {1003}, {1}, {58}}  score{${st}, {1003}, {2}, {62}}  score{${st}, {1003}, {3}, {55}}
    score{${st}, {1004}, {1}, {91}}  score{${st}, {1004}, {2}, {86}}  score{${st}, {1004}, {3}, {94}}
    score{${st}, {2001}, {1}, {66}}  score{${st}, {2001}, {2}, {70}}  score{${st}, {2001}, {3}, {68}}
    score{${st}, {2002}, {1}, {49}}  score{${st}, {2002}, {2}, {55}}  score{${st}, {2002}, {3}, {52}}
    score{${st}, {2003}, {1}, {78}}  score{${st}, {2003}, {2}, {74}}  score{${st}, {2003}, {3}, {80}}
    score{${st}, {2004}, {1}, {88}}  score{${st}, {2004}, {2}, {92}}  score{${st}, {2004}, {3}, {90}}
    score{${st}, {3001}, {1}, {95}}  score{${st}, {3001}, {2}, {93}}  score{${st}, {3001}, {3}, {97}}
    score{${st}, {3002}, {1}, {61}}  score{${st}, {3002}, {2}, {58}}  score{${st}, {3002}, {3}, {63}}

    // ---- 汇总加权 + 分班 ----
    calcAll{${st}}
    assign{${st}, ${thr}}

    // ---- 学籍变动：1002 转出，2002 退学，3003 转入 ----
    transferOut{${st}, {1002}}
    dropOut{${st}, {2002}}
    enroll{${st}, {3003}, {3}, {2}}
    score{${st}, {3003}, {1}, {71}}  score{${st}, {3003}, {2}, {76}}  score{${st}, {3003}, {3}, {79}}
    calcAll{${st}}
    assign{${st}, ${thr}}

    // ---- 报表 ----
    .{str; "===== 学生名册 =====\n"}
    roster{${st}}

    .{str; "\n===== 班级平均分（在读）=====\n"}
    .{str; "1班 "} .{double; classAvg{${st}, {1}}} .{str; "\n"}
    .{str; "2班 "} .{double; classAvg{${st}, {2}}} .{str; "\n"}
    .{str; "3班 "} .{double; classAvg{${st}, {3}}} .{str; "\n"}

    .{str; "\n===== 好班名单（加权 >= 60）=====\n"}
    &{int;i} = {0}
    [${i} < ${st}.size{}]{
        (${st}{${i}}.id != {0}){
            (${st}{${i}}.status == {0}){
                (${st}{${i}}.track == {1}){
                    .{int; ${st}{${i}}.id}
                    .{str; " "}
                }
            }
        }
        ${i} = ${i} + {1}
    }
    .{str; "\n===== 汇总 =====\n"}

    &{int;nOn} = {0} &{int;nOut} = {0} &{int;nQuit} = {0} &{int;nGood} = {0}
    ${i} = {0}
    [${i} < ${st}.size{}]{
        (${st}{${i}}.id != {0}){
            (${st}{${i}}.status == {0}){
                ${nOn} = ${nOn} + {1}
                (${st}{${i}}.track == {1}){ ${nGood} = ${nGood} + {1} }
            }
            (${st}{${i}}.status == {1}){ ${nOut} = ${nOut} + {1} }
            (${st}{${i}}.status == {2}){ ${nQuit} = ${nQuit} + {1} }
        }
        ${i} = ${i} + {1}
    }
    .{str; "在读 "} .{int; ${nOn}}
    .{str; "  转出 "} .{int; ${nOut}}
    .{str; "  退学 "} .{int; ${nQuit}}
    .{str; "  好班 "} .{int; ${nGood}}
    .{str; "  普通班 "} .{int; ${nOn} - ${nGood}}
    .{str; "\n"}
}
