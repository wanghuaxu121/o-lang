// ??????.{fmt; "???"; ???}   ??? %d %c %s %g %f %%
O{
    &{int;a} = {3}
    &{int;b} = {4}
    &{char;c} = {65}
    &{str;s} = {"hi"}
    &{double;d} = {1.5}
    .{fmt; "a=%d b=%d sum=%d\n"; ${a}; ${b}; ${a} + ${b}}
    .{fmt; "c=%c s=%s d=%g pct=%%\n"; ${c}; ${s}; ${d}}
    &{int;i} = {1}
    [${i} <= {3}]{
        .{fmt; "[%d]"; ${i}}
        ${i} = ${i} + {1}
    }
    .{fmt; "\n"}
}