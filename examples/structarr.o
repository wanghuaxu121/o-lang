// 结构体数组 + 字段（C 后端覆盖 sizeof 与字段偏移）
&{struct;Pt} = {{int;x}, {int;y}}

O{
    &{Pt;ps} = {Pt{0;2}} = {}
    &{int;i} = {0}

    [${i} < {3}]{
        ${ps}{${i}}.x = ${i}
        ${ps}{${i}}.y = ${i} * {10}
        ${i} = ${i} + {1}
    }

    ${i} = {0}
    [${i} < {3}]{
        (${i} > {0}){
            .{str; " "}
        }
        .{int; ${ps}{${i}}.x}
        .{str; ":"}
        .{int; ${ps}{${i}}.y}
        ${i} = ${i} + {1}
    }
    .{str; "\n"}
}
