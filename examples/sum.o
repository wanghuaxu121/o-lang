// SPEC §12.3  数组求和：地址区间 + 引用 + 下标 + size
O{
    // 静态区 [0..9]：10 个 int，零初始化
    &{int;a} = {int{0;9}} = {}

    // 静态区 [10]：循环变量
    &{int;i} = {int{10}} = {0}

    // 初始化 a[i] = i + 1
    [${i} < ${a}.size{}]{
        ${a}{${i}} = ${i} + {1}
        ${i} = ${i} + {1}
    }

    // 静态区 [11]：累加器
    &{int;s} = {int{11}} = {0}
    ${i} = {0}

    [${i} < ${a}.size{}]{
        ${s} = ${s} + ${a}{${i}}
        ${i} = ${i} + {1}
    }

    .{int; ${s}}
    .{str; "\n"}
}
