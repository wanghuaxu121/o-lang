<!doctype html>
<html><head><meta charset='utf-8'><title>O 语言 · 月考报表</title>
<style>body{font-family:sans-serif;margin:28px;background:#fafafa}table{border-collapse:collapse;margin:12px 0 24px}td,th{border:1px solid #ddd;padding:6px 14px;text-align:right}th{background:#eef2ff}#chart div{margin:6px 0}.bar{height:16px;background:#2b6cff;border-radius:3px}</style></head><body>
<h2>班级月考成绩</h2>
<table>
<tr><th>班级</th><th>月考1</th><th>月考2</th><th>月考3</th><th>加权</th></tr>
<tr><td>1</td><td>85</td><td>90</td><td>88</td><td>88</td></tr>
<tr><td>2</td><td>72</td><td>75</td><td>70</td><td>71.9</td></tr>
<tr><td>3</td><td>58</td><td>62</td><td>55</td><td>57.7</td></tr>
</table>
<h2>加权分对比</h2>
<div id='chart'></div>
<script>
const data=[
 {cls:1,avg:88},
 {cls:2,avg:71.9},
 {cls:3,avg:57.7},
];
for(const d of data){
  const row=document.createElement('div');
  const pct=Math.round(d.avg);
  row.innerHTML='<span>'+d.cls+'班 '+d.avg.toFixed(1)+'</span>'
    +'<div class=bar style=width:'+(pct*4)+'px></div>';
  document.getElementById('chart').appendChild(row);
}
</script>
</body></html>
