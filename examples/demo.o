// SPEC §7.3
// SPEC §7.1
// SPEC §7.2
// demo.o —— 冒泡排序 + 统计
// 覆盖：数组 / 引用参数 / 函数 / 循环 / 条件 / 下标 / 多返回值式引用
&{int;sort} = o{{int{0;7};&a}}{
    &{int;i} = {0}
    [${i} < ${a}.size{}]{
        &{int;j} = {0}
        [${j} < ${a}.size{} - ${i} - {1}]{
            (${a}{${j}} > ${a}{${j} + {1}}){
                &{int;t} = {0}
                ${t} = ${a}{${j}}
                ${a}{${j}} = ${a}{${j} + {1}}
                ${a}{${j} + {1}} = ${t}
            }
            ${j} = ${j} + {1}
        }
        ${i} = ${i} + {1}
    }
    ?{0}
}

&{int;stats} = o{{int{0;7};&a}, {int;&sum}, {int;&mn}, {int;&mx}}{
    ${sum} = {0}
    ${mn} = ${a}{0}
    ${mx} = ${a}{0}
    &{int;i} = {0}
    [${i} < ${a}.size{}]{
        ${sum} = ${sum} + ${a}{${i}}
        (${a}{${i}} < ${mn}){ ${mn} = ${a}{${i}} }
        (${a}{${i}} > ${mx}){ ${mx} = ${a}{${i}} }
        ${i} = ${i} + {1}
    }
    ?{0}
}

O{
    &{int;v} = {int{0;7}} = {5; 3; 9; 1; 7; 2; 8; 4}

    .{str; "before: "}
    &{int;k} = {0}
    [${k} < ${v}.size{}]{
        (${k} > {0}){ .{str; " "} }
        .{int; ${v}{${k}}}
        ${k} = ${k} + {1}
    }
    .{str; "\n"}

    sort{${v}}

    .{str; "sorted: "}
    ${k} = {0}
    [${k} < ${v}.size{}]{
        (${k} > {0}){ .{str; " "} }
        .{int; ${v}{${k}}}
        ${k} = ${k} + {1}
    }
    .{str; "\n"}

    &{int;sum} = {0}
    &{int;mn} = {0}
    &{int;mx} = {0}
    stats{${v}, ${sum}, ${mn}, ${mx}}
    .{str; "sum="}
    .{int; ${sum}}
    .{str; " min="}
    .{int; ${mn}}
    .{str; " max="}
    .{int; ${mx}}
    .{str; "\n"}
}
