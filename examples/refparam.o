// v0.2 引用参数：swap + 通过引用写数组
&{int;swap} = o{{int;&a}, {int;&b}}{
    &{int;t} = {0}
    ${t} = ${a}
    ${a} = ${b}
    ${b} = ${t}
    ?{0}
}

&{int;fill} = o{{int{0;3};&buf}, {int;v}}{
    &{int;i} = {0}
    [${i} < ${buf}.size{}]{
        ${buf}{${i}} = ${v}
        ${i} = ${i} + {1}
    }
    ?{0}
}

O{
    &{int;x} = {1}
    &{int;y} = {2}
    swap{${x}, ${y}}
    .{int; ${x}}
    .{str; " "}
    .{int; ${y}}
    .{str; " | "}

    &{int;arr} = {int{0;3}} = {}
    fill{${arr}, {7}}
    &{int;k} = {0}
    [${k} < {4}]{
        .{int; ${arr}{${k}}}
        ${k} = ${k} + {1}
    }
    .{str; "\n"}
}
